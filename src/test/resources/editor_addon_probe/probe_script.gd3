@tool
class_name ProbeScript
extends ScriptExtension

## Phase 0 probe: proves a gdcc class can extend ScriptExtension and override its engine
## virtuals with exact metadata signatures (doc/module_impl/editor_addon/
## gd3_editor_integration_implementation.md §5). Never instantiated as a real script.

var _source: String = ""
var _language: ProbeLang = null

func setup(language: ProbeLang) -> void:
    _language = language

func set_source(code: String) -> void:
    _source = code

func _can_instantiate() -> bool:
    return false

func _get_language() -> ScriptLanguage:
    return _language

func _has_source_code() -> bool:
    return true

func _get_source_code() -> String:
