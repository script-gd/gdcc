@tool
class_name GdccScriptLanguage
extends ScriptLanguageExtension

## Virtual `ScriptLanguage` for `.gd3` files (implementation plan §2.2/§3.2). Registered by
## GdccEditorService and held by every loaded GdccScript, so the instance is process-resident
## and never freed for the whole editor session.
##
## Every `required` virtual that editor code paths can reach is implemented explicitly —
## falling through to the base GDVIRTUAL defaults would print ERR_PRINT_ONCE noise. The
## `_debug_*` / `_profiling_*` group is skipped on purpose: debugging and profiling are
## non-goals and those paths are never triggered; the `void*` / `ProfilingInfo*` signatures
## are not expressible anyway.

var _service: GdccEditorService = null


## Dependency injection by the service; both are process-resident, so the reference stays valid
## across plugin disable/enable cycles.
func setup(service: GdccEditorService) -> void:
    _service = service


func _init() -> void:
    # Doubles as the engine `_init` virtual and the gdcc constructor hook (probe-verified);
    # the engine never calls `init()` on a late-registered language.
    pass


func _get_name() -> String:
    return "GD3"


func _get_type() -> String:
    return "GdccScript"


func _get_extension() -> String:
    return "gd3"


func _get_recognized_extensions() -> PackedStringArray:
    return PackedStringArray(["gd3"])


func _get_reserved_words() -> PackedStringArray:
    # GDScript keyword set: `.gd3` shares GDScript surface syntax, so highlighting and word
    # movement behave identically to `.gd`.
    return PackedStringArray([
        "if", "elif", "else", "for", "while", "match", "break", "continue", "pass", "return",
        "class", "class_name", "extends", "is", "in", "as", "self", "super", "signal", "func",
        "static", "const", "enum", "var", "breakpoint", "preload", "await", "assert", "void",
        "and", "or", "not", "true", "false", "null",
    ])


func _is_control_flow_keyword(keyword: String) -> bool:
    return keyword == "if" or keyword == "elif" or keyword == "else" or keyword == "for" \
            or keyword == "while" or keyword == "match" or keyword == "break" \
            or keyword == "continue" or keyword == "pass" or keyword == "return"


func _get_comment_delimiters() -> PackedStringArray:
    return PackedStringArray(["#"])


func _get_doc_comment_delimiters() -> PackedStringArray:
    return PackedStringArray(["##"])


func _get_string_delimiters() -> PackedStringArray:
    return PackedStringArray(["\" \"", "' '", "\"\"\" \"\"\""])


# Reentry guard: `_validate` runs on the editor UI thread and must stay single-flight —
# its inline LSP wait pumps socket IO, which could otherwise interleave with a nested
# editor validation triggered by signal handlers.
var _in_validate: bool = false

# Hard bound for the inline diagnostics wait (plan §4.2, ≤150ms). A var, not a const:
# class-level const is outside gdcc's bootstrap MVP.
var VALIDATE_LSP_TIMEOUT_MSEC: int = 150

# Total guard-passing `_validate` invocations (observability probe; the Phase 5
# revalidation acceptance anchors "the editor revalidated with no driver-side call" on
# this counter advancing — engine test `diag_revalidate`).
var _validate_call_count: int = 0


## Total `_validate` invocations that passed the entry guard (see `_validate_call_count`).
func validate_call_count() -> int:
    return _validate_call_count


## Diagnostic merge entry (plan §4.2). Two channels feed the result:
## 1. GDScript LSP: full-sync the buffer, wait ≤ `VALIDATE_LSP_TIMEOUT_MSEC` for that
##    generation's diagnostics, then map severity 1 → errors / 2 → warnings (LSP positions
##    are 0-based, so both line and column get +1).
## 2. gdcc: `notify_source_changed` runs FIRST on every call (LSP errors never suppress dirty
##    marking, only the display); cached analyze.run diagnostics merge only when their
##    content version matches this exact text, and only while LSP reported no errors (cascade
##    noise suppression, plan §4.2 step 3). gdcc positions are already 1-based — no shift.
## `path` is mandatory on errors, otherwise the editor files them under "dependency
## script errors" instead of the current tab. While the service is uninstalled the answer is
## the safe `{"valid": true}`; a timed-out LSP wait falls back to the URI's cached
## diagnostics, whose errors still count (stale beats none).
func _validate(script: String, path: String, validate_functions: bool, validate_errors: bool, validate_warnings: bool, validate_safe_lines: bool) -> Dictionary:
    if _in_validate or _service == null or not _service.is_active():
        return {"valid": true}
    _in_validate = true
    _validate_call_count += 1
    var errors: Array = []
    var warnings: Array = []
    if _service.is_lsp_ready():
        # A timeout simply means the freshest generation did not arrive; the cache read
        # below then yields the previous diagnostics (stale beats none).
        # Phase 7: the LSP view may have the `class_name` line erased (pseudo-error
        # suppression); returned diagnostics on the erased line map their column back to
        # the raw text here. The gdcc analysis channel below always sees the raw text.
        var view: Dictionary = _service.lsp_safe_text(path, script)
        _service.lsp_sync_and_wait(path, str(view["text"]), VALIDATE_LSP_TIMEOUT_MSEC)
        var diagnostics: Array = _service.lsp_diagnostics_for(path)
        for raw in diagnostics:
            if not (raw is Dictionary):
                continue
            var severity: int = int(raw.get("severity", 0))
            var range_value: Variant = raw.get("range", {})
            if not (range_value is Dictionary):
                continue
            var start_value: Variant = range_value.get("start", {})
            var end_value: Variant = range_value.get("end", {})
            if not (start_value is Dictionary) or not (end_value is Dictionary):
                continue
            var line: int = int(start_value.get("line", 0)) + 1
            var character: int = _service.lsp_safe_reverse_column(
                    view, int(start_value.get("line", 0)), int(start_value.get("character", 0))) + 1
            var end_line: int = int(end_value.get("line", 0)) + 1
            var message: String = str(raw.get("message", ""))
            if severity == 1:
                errors.append({"line": line, "column": character, "message": message, "path": path})
            elif severity == 2:
                # All five keys are mandatory — the engine silently drops partial entries.
                warnings.append({
                    "start_line": line,
                    "end_line": end_line,
                    "code": 0,
                    "string_code": "GDSCRIPT_LSP",
                    "message": message,
                })
    var content_version: int = _service.notify_source_changed(path, script)
    if errors.is_empty() and content_version >= 0:
        for item in _service.gdcc_diagnostics_for(path, content_version):
            if not (item is Dictionary):
                continue
            var category: String = str(item.get("category", ""))
            var gdcc_message: String = "[gdcc " + category + "] " + str(item.get("message", ""))
            # File-level fallback for diagnostics without a range (plan §4.2 step 3).
            var gdcc_line: int = 1
            var gdcc_column: int = 1
            var gdcc_end_line: int = 1
            var gdcc_range: Variant = item.get("range")
            if gdcc_range is Dictionary:
                var gdcc_start: Variant = gdcc_range.get("start")
                var gdcc_end: Variant = gdcc_range.get("end")
                if gdcc_start is Dictionary:
                    gdcc_line = int(gdcc_start.get("line", 1))
                    gdcc_column = int(gdcc_start.get("column", 1))
                if gdcc_end is Dictionary:
                    gdcc_end_line = int(gdcc_end.get("line", gdcc_line))
            var severity_text: String = str(item.get("severity", ""))
            if severity_text == "ERROR":
                errors.append({"line": gdcc_line, "column": gdcc_column, "message": gdcc_message, "path": path})
            elif severity_text == "WARNING":
                warnings.append({
                    "start_line": gdcc_line,
                    "end_line": gdcc_end_line,
                    "code": 0,
                    "string_code": category,
                    "message": gdcc_message,
                })
    _in_validate = false
    return {"valid": errors.is_empty(), "errors": errors, "warnings": warnings}


func _validate_path(path: String) -> String:
    return ""


func _create_script() -> Object:
    var script: GdccScript = GdccScript.new()
    script.setup(self)
    return script


func _supports_builtin_mode() -> bool:
    # A `.gd3` must never become a scene built-in script (no instantiation path exists).
    return false


func _supports_documentation() -> bool:
    return false


func _can_inherit_from_file() -> bool:
    return false


func _handles_global_class_type(type: String) -> bool:
    return type == "GdccScript"


func _has_named_classes() -> bool:
    return false


func _find_function(function: String, code: String) -> int:
    return code.find("func " + function)


func _make_function(class_name: String, function_name: String, function_args: PackedStringArray) -> String:
    return "func " + function_name + "(" + ", ".join(function_args) + "):\n\tpass\n"


func _can_make_function() -> bool:
    return false


func _open_in_external_editor(script: Script, line: int, column: int) -> int:
    return ERR_UNAVAILABLE


func _overrides_external_editor() -> bool:
    return false


## Completion entry (plan §4.3). The editor hands over the buffer text with a 0xFFFF
## sentinel inserted at the caret (`CodeEdit.get_text_for_code_completion`); the GDScript
## LSP server completes from the SYNCED document plus the request position, so the sentinel
## is located, translated into a 0-based code-point (line, character) pair, and stripped
## before the sync. Positions count code points end to end — Godot Strings index code
## points and the server's completion path does the same (§2.6/R11) — so multibyte text on
## the caret line cannot shift the request. Any failure answers the degraded dictionary.
## No reentry guard is needed (unlike `_validate`): the bounded pump inside
## `request_blocking` drives only socket IO, which can never call back into this virtual.
func _complete_code(code: String, path: String, owner: Object) -> Dictionary:
    if _service == null or not _service.is_active():
        return _completion_degraded()
    var caret: int = code.find(String.chr(0xFFFF))
    if caret < 0:
        return _completion_degraded()
    var before: String = code.substr(0, caret)
    var line: int = before.count("\n")
    var last_break: int = before.rfind("\n")
    # `last_break == -1` (caret on the first line) folds to `before.length()` naturally.
    var character: int = before.length() - last_break - 1
    var clean: String = before + code.substr(caret + 1)
    # Phase 7: sync the erased view (same text `_validate` would send) and forward-map the
    # request position — a caret past the erased prefix on that line shifts left with it.
    var view: Dictionary = _service.lsp_safe_text(path, clean)
    var mapped: Dictionary = _service.lsp_safe_forward_position(view, line, character)
    var response: Dictionary = _service.request_completion(
            path, str(view["text"]), int(mapped["line"]), int(mapped["character"]))
    if response.get("ok") != true:
        return _completion_degraded()
    return {"result": OK, "force": false, "call_hint": "", "options": _completion_options(response.get("result"))}


## The safe failure answer. All four keys are mandatory: a missing `result` is treated as
## ERR_UNAVAILABLE by the engine anyway, but the explicit shape keeps every failure path
## indistinguishable and complete.
func _completion_degraded() -> Dictionary:
    return {"result": ERR_UNAVAILABLE, "force": false, "call_hint": "", "options": []}


## LSP completion result → engine option list. The 4.5 GDScript server answers with a bare
## CompletionItem array; the spec's CompletionList wrapper (`{"items": [...]}`) is accepted
## defensively. Items without a usable label are dropped — the engine would show an empty
## row. Every option carries the seven mandatory keys verbatim (a missing key makes
## `ScriptLanguageExtension.complete_code` skip the option silently); the optional `matches`
## key is omitted — the engine guards its read with `op.has("matches")` (4.5
## `script_language_extension.h`) and CodeEdit computes highlighting itself.
func _completion_options(result: Variant) -> Array:
    var items: Array = []
    if result is Array:
        items = result
    elif result is Dictionary:
        var listed: Variant = result.get("items", [])
        if listed is Array:
            items = listed
    var options: Array = []
    for item in items:
        if not (item is Dictionary):
            continue
        var label: String = str(item.get("label", ""))
        if label.is_empty():
            continue
        options.append({
            "kind": _completion_kind(int(item.get("kind", 0))),
            "display": label,
            "insert_text": _completion_insert_text(item, label),
            "font_color": Color(1, 1, 1),
            "icon": null,
            "default_value": null,
            # LOCATION_OTHER: no local/parent-scope ranking evidence exists for LSP items.
            "location": 1024,
        })
    return options


## Insert-text precedence (plan §4.3): `textEdit.newText`, then `insertText`, then the
## label. The 4.5 GDScript server only ever sends `insertText`; the textEdit branch keeps
## the mapping spec-tolerant. An empty string counts as absent (LSP treats omitted
## insertText as "insert the label").
func _completion_insert_text(item: Dictionary, label: String) -> String:
    var text_edit: Variant = item.get("textEdit")
    if text_edit is Dictionary:
        var new_text: String = str(text_edit.get("newText", ""))
        if not new_text.is_empty():
            return new_text
    var insert_text: String = str(item.get("insertText", ""))
    if not insert_text.is_empty():
        return insert_text
    return label


## LSP CompletionItemKind → CodeEdit CodeCompletionKind (plan §4.3). Kind values verified
## against the 4.5 server's own mapping (`gdscript_text_document.cpp`): it actually emits
## Text=1, Method=2, Variable=6, Class=7, Property=10, Enum=13, Snippet=15 (node paths),
## File=17, Constant=21, Event=23; the other arms are spec-tolerant fallbacks. Snippet maps
## to KIND_NODE_PATH (7) rather than the plan's generic fall-through because the server
## emits it exclusively for node-path options.
func _completion_kind(lsp_kind: int) -> int:
    if lsp_kind == 7:  # Class
        return 0  # KIND_CLASS
    if lsp_kind == 2 or lsp_kind == 3 or lsp_kind == 4:  # Method/Function/Constructor
        return 1  # KIND_FUNCTION
    if lsp_kind == 23:  # Event
        return 2  # KIND_SIGNAL
    if lsp_kind == 6 or lsp_kind == 5:  # Variable/Field
        return 3  # KIND_VARIABLE
    if lsp_kind == 10:  # Property
        return 4  # KIND_MEMBER
    if lsp_kind == 13:  # Enum
        return 5  # KIND_ENUM
    if lsp_kind == 21 or lsp_kind == 20 or lsp_kind == 12:  # Constant/EnumMember/Value
        return 6  # KIND_CONSTANT
    if lsp_kind == 15:  # Snippet (node paths on the GDScript server)
        return 7  # KIND_NODE_PATH
    if lsp_kind == 17 or lsp_kind == 19:  # File/Folder
        return 8  # KIND_FILE_PATH
    return 9  # KIND_PLAIN_TEXT (4.5 has no KEYWORD kind)


func _lookup_code(code: String, symbol: String, path: String, owner: Object) -> Dictionary:
    return {"result": ERR_UNAVAILABLE, "type": 0}


func _auto_indent_code(code: String, from_line: int, to_line: int) -> String:
    return code


func _get_global_class_name(path: String) -> Dictionary:
    return {}


func _make_template(template: String, class_name: String, base_class_name: String) -> Script:
    return null


func _get_built_in_templates(object: StringName) -> Array[Dictionary]:
    var result: Array[Dictionary] = []
    return result


func _is_using_templates() -> bool:
