@tool
class_name GdccDiagCache
extends Node

## Diagnostics cache for the gdcc channel (plan §4.2 step 3 / §4.4). Child feature of
## `GdccEditorService`: the scheduler's merge is the only writer; `_validate` reads through
## `diagnostics_for`. Entries are served only while the diagnostics module is READY — plan
## §4.4's offline degrade leaves `_validate` with the LSP channel alone instead of stale
## entries.
##
## Stale-visible read contract (post-Phase-10 fix): an edit advances the registry version
## instantly, but the previous round's diagnostics KEEP being served until the fresh round
## merges over them. The editor replaces a tab's displayed markers wholesale with every
## `_validate` result, so dropping the entry on version mismatch would blank the gutter for
## the whole debounce+analysis window and leave the user fixing code blind. Version
## freshness remains observable through `is_version_current` (the revalidation gate and
## tests key on it); only the read path relaxed.

# res:// path -> {"version": int, "items": Array}. `items` are raw analyze.run diagnostic
# Dictionaries.
var _entries: Dictionary = {}

var service: GdccEditorService = null


func bind_service(owner: GdccEditorService) -> void:
    service = owner


## Cached analyze.run diagnostics for `path`, or empty when none was ever merged or the
## module is unavailable. The entry may have been built from an OLDER text than `_version`
## (the user typed since): it stays visible until the scheduler's fresh round replaces it,
## because the editor would otherwise clear the displayed markers for the whole analysis
## window. `_version` identifies the text being validated; it no longer gates the read.
func diagnostics_for(path: String, _version: int) -> Array:
    if not service.is_active() or not service.lifecycle().is_ready():
        return []
    return _latest_items(path)


## Freshness probe: true when an entry for `path` exists and was built from exactly
## `version` — regardless of whether that round produced diagnostics (`diagnostics_for`
## alone cannot distinguish "clean" from "stale/missing"). Intentionally NOT gated on module
## readiness: tests use it to observe cache state directly.
func is_version_current(path: String, version: int) -> bool:
    if not service.is_active():
        return false
    var entry: Variant = _entries.get(path)
    if not (entry is Dictionary):
        return false
    return int(entry.get("version", -1)) == version


func set_items(path: String, version: int, items: Array) -> void:
    _entries[path] = {"version": version, "items": items}


func erase(path: String) -> void:
    _entries.erase(path)


func _latest_items(path: String) -> Array:
    var entry: Variant = _entries.get(path)
    if not (entry is Dictionary):
        return []
    var items: Variant = (entry as Dictionary).get("items", [])
    if items is Array:
        return items
    return []


## Cached diagnostics belong to the dead channel epoch: publishing them on re-ready before a
## fresh analysis round would resurrect stale results (they are rebuilt by the re-mirror +
## re-analysis that follows).
func on_module_outage() -> void:
    _entries.clear()


func service_reset_channel() -> void:
    _entries.clear()


func service_shutdown() -> void:
    _entries.clear()
