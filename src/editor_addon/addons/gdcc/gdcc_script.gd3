@tool
class_name GdccScript
extends ScriptExtension

## Resource carrier for `.gd3` source text (implementation plan §2.3/§3.1). `_can_instantiate`
## is hard-false: a `.gd3` file is never executed as a script — the runtime behavior of its
## classes comes exclusively from the native library gdcc compiles it into.
##
## The header parse (`class_name` / `extends`) is a deliberate line scan without RegEx: it
## answers the two engine queries `_get_global_name` / `_get_instance_base_type`, nothing more.

var _source: String = ""
# Validity contract: true once the script carries source text — loaded from disk
# (`load_from_text`) or set in memory (`_set_source_code`, the editor's create-then-edit
# path) — and false again after a failed `_reload`.
var _valid: bool = false
var _global_name: StringName = &""
var _base_type: StringName = &"RefCounted"
var _language: GdccScriptLanguage = null
# Path the loader read this resource from; `_reload` prefers the engine-bound `get_path()`
# (which tracks `take_over_path` and renames) and falls back to this recorded load path.
var _path: String = ""


## Dependency injection at creation time (loader / language factory); the instance graph has no
## singleton lookups so worker-thread loads stay free of shared-state access.
func setup(language: GdccScriptLanguage) -> void:
    _language = language


## Fills every derived field from freshly read source text. Shared by the format loader and
## `_reload` so the parse never diverges between the two entry points.
func load_from_text(path: String, text: String) -> void:
    _path = path
    _source = text
    _valid = true
    _parse_header()


func _can_instantiate() -> bool:
    return false


## The editor never null-checks `get_language()` (e.g. `script_text_editor.cpp` dereferences
## it for highlighting and validation), so a script must always answer with its language.
## Instances created through the loader or the language factory get it via `setup()`; instances
## created directly through ClassDB (e.g. the Create Resource dialog) self-heal here: first the
## registered language table (ACTIVE), then the resident service's still-valid instance
## (UNINSTALLED — the resident language is never freed by design).
func _get_language() -> ScriptLanguage:
    if _language != null:
        return _language
    var i: int = 0
    while i < Engine.get_script_language_count():
        var candidate: ScriptLanguage = Engine.get_script_language(i)
        if candidate is GdccScriptLanguage:
            _language = candidate as GdccScriptLanguage
            return _language
        i = i + 1
    var main_loop: MainLoop = Engine.get_main_loop()
    if main_loop is SceneTree:
        var tree: SceneTree = main_loop as SceneTree
        var service: Node = tree.root.get_node_or_null(NodePath("GdccEditorService"))
        if service is GdccEditorService:
            var found: GdccScriptLanguage = (service as GdccEditorService).get_language_instance()
            if found != null:
                _language = found
    return _language


func _has_source_code() -> bool:
    return true


func _get_source_code() -> String:
    return _source


func _set_source_code(code: String) -> void:
    _source = code
    _valid = true
    _parse_header()


## Re-reads the file and refreshes the source and header fields only. Scheduling analysis from
## here would violate the worker-thread purity rule of ResourceFormatLoader loads (the editor
## reloads resources off the main thread), so this method is intentionally side-effect free.
func _reload(keep_state: bool) -> int:
    var path: String = get_path()
    if path == "":
        path = _path
    if path == "" or not FileAccess.file_exists(path):
        _valid = false
        return ERR_FILE_NOT_FOUND
    load_from_text(path, FileAccess.get_file_as_string(path))
    return OK


func _is_valid() -> bool:
    return _valid


func _is_tool() -> bool:
    # Never let the editor try to execute a `.gd3` as a tool script.
    return false


func _get_instance_base_type() -> StringName:
    return _base_type


func _get_global_name() -> StringName:
    return _global_name


func _get_base_script() -> Script:
    return null


func _inherits_script(script: Script) -> bool:
    return false


func _instance_has(object: Object) -> bool:
    return false


func _get_doc_class_name() -> StringName:
    return &""


func _get_documentation() -> Array[Dictionary]:
    var result: Array[Dictionary] = []
    return result


func _get_class_icon_path() -> String:
    return ""


func _has_method(method: StringName) -> bool:
    return false


func _has_static_method(method: StringName) -> bool:
    return false


func _has_script_signal(signal: StringName) -> bool:
    return false


func _has_property_default_value(property: StringName) -> bool:
    return false


func _get_property_default_value(property: StringName) -> Variant:
    return null


func _get_method_info(method: StringName) -> Dictionary:
    return {}


func _get_member_line(member: StringName) -> int:
    return -1


func _editor_can_reload_from_file() -> bool:
    return true


func _update_exports() -> void:
    pass


func _get_rpc_config() -> Variant:
    return null


func _is_placeholder_fallback_enabled() -> bool:
    return false


func _get_members() -> Array[StringName]:
    var result: Array[StringName] = []
    return result


func _get_constants() -> Dictionary:
    return {}


func _get_script_method_list() -> Array[Dictionary]:
    var result: Array[Dictionary] = []
    return result


func _get_script_property_list() -> Array[Dictionary]:
    var result: Array[Dictionary] = []
    return result


func _get_script_signal_list() -> Array[Dictionary]:
    var result: Array[Dictionary] = []
    return result


## Header scan: only column-0 lines are considered (an indented `extends`/`class_name` belongs
## to an inner class or block — or is simply invalid code being tolerated — and must never
## override the top-level header). Keyword boundaries accept spaces and tabs; the single-line
## `class_name X extends Y` form (space-separated) is handled as well. A quoted
## `extends "res://..."` path cannot be resolved to a base type here, so the default
## `RefCounted` stands (the real base check is gdcc's compile-time job).
func _parse_header() -> void:
    _global_name = &""
    _base_type = &"RefCounted"
    var lines: PackedStringArray = _source.split("\n")
    var i: int = 0
    while i < lines.size():
        var raw: String = lines[i]
        i = i + 1
        if raw.length() == 0:
            continue
        var first: int = raw.unicode_at(0)
        if first == 32 or first == 9:
            continue
        var line: String = raw.strip_edges()
        if line.begins_with("#") or line.begins_with("@"):
            continue
        if _keyword_matches(line, "extends"):
            var base: String = _parse_base_token(line.substr(7).strip_edges())
            if base != "":
                _base_type = StringName(base)
        elif _keyword_matches(line, "class_name"):
            var rest: String = line.substr(10).strip_edges()
            var found: String = _first_token(rest)
            if found != "":
                _global_name = StringName(found)
            var combined: int = _find_keyword_index(rest, "extends")
            if combined >= 0:
                var base_combined: String = _parse_base_token(rest.substr(combined + 7).strip_edges())
                if base_combined != "":
                    _base_type = StringName(base_combined)


## True when `text` is exactly `keyword` or starts with it followed by a space or tab.
func _keyword_matches(text: String, keyword: String) -> bool:
    if text == keyword:
        return true
    if not text.begins_with(keyword) or text.length() <= keyword.length():
        return false
    var boundary: int = text.unicode_at(keyword.length())
    return boundary == 32 or boundary == 9


## First index of `keyword` bounded by space/tab on both sides, or -1. Used for the single-line
## `class_name X extends Y` form regardless of which whitespace separates the parts.
func _find_keyword_index(text: String, keyword: String) -> int:
    var idx: int = text.find(keyword)
    while idx >= 0:
        var before_ok: bool = idx > 0 and (text.unicode_at(idx - 1) == 32 or text.unicode_at(idx - 1) == 9)
        var after: int = idx + keyword.length()
        var after_ok: bool = after >= text.length() or text.unicode_at(after) == 32 or text.unicode_at(after) == 9
        if before_ok and after_ok:
            return idx
        idx = text.find(keyword, idx + 1)
    return -1


## Returns the base-type token, or "" when the extends target is a quoted path.
func _parse_base_token(rest: String) -> String:
    if rest.begins_with("\"") or rest.begins_with("'"):
        return ""
    return _first_token(rest)


## First run of non-separator characters; a trailing `,` (icon path) or `#` (comment) ends it.
func _first_token(text: String) -> String:
    var end: int = 0
    while end < text.length():
        var ch: int = text.unicode_at(end)
        if ch == 32 or ch == 9 or ch == 44 or ch == 35:
            break
        end = end + 1
    return text.substr(0, end)
