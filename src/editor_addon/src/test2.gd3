@tool
class_name Test2 extends MeshInstance3D

@export var rotating_speed: float = 30;
@export var bouncing_speed: float = 1;
var time: float = 0.0;

func _process(delta: float) -> void:
    time += delta;
    
    self.rotation.y = fmod(rotating_speed * time / 180.0, TAU);
       
    self.position.y = abs(sin(time * self.bouncing_speed));
