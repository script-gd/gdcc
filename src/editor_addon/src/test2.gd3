@tool
class_name Test2 extends MeshInstance3D

@export var rotating_speed: float = 30;
var time: float = 0.0;

func _process(delta: float) -> void:
    time += delta;
    
    self.rotation_degrees.x += rotating_speed * delta;
    self.rotation_degrees.x = fmod(self.rotation_degrees.x, 360);
    
    self.position.y = sin(time);
